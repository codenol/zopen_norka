# Copy to `.env` and fill in. `.env` is what `docker compose` reads, and it holds
# the first administrator's password — so it stays out of version control and
# readable only by the account that deploys (`chmod 600 .env`).

# The hostname people will type. Its A record must already point at this server,
# or Caddy's certificate challenge fails on first start.
DOMAIN=openpencil.example.com

# Where Let's Encrypt sends expiry warnings about the certificate above.
ACME_EMAIL=you@example.com

# The first administrator, created at start-up if the account store is fresh.
# Ignored once an admin exists — changing it later does NOT change the password
# of an existing account. To replace a forgotten password, use
# `op admin` against the same OPENPENCIL_ONLINE_DATA_DIR (see README.md).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-you-deploy

# The image to run. `local` is what `docker compose build` produces on the host;
# set a tag once the image is pushed to a registry.
OPENPENCIL_IMAGE=openpencil-web-rust:local

# `info` is enough to see start-up, accounts and errors. `debug` is very loud.
RUST_LOG=info
