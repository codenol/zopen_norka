# TLS in front of the daemon, and the only thing exposed on the host.
#
# Caddy obtains and renews the certificate for ${DOMAIN} (set in .env) on its
# first start, which is why the domain's A record has to point at this host
# BEFORE `docker compose up`: without it, the challenge fails and Caddy retries
# with backoff.

{
	# The address behind which the certificate is requested. A real address is
	# required — with a bare email, a failing renewal is silent, and an expired
	# certificate is an outage that looks like a browser problem.
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# The daemon speaks HTTP and knows nothing about TLS. `X-Forwarded-*` is what
	# makes it see the real client and scheme, so a redirect or an absolute link
	# it builds comes out as https.
	reverse_proxy openpencil:3100 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}

	# The editor is a wasm bundle and a page; nothing here is cacheable across a
	# deploy, and a stale bundle is the classic "my change did nothing" report.
	# `no-cache` keeps the revalidation, which is what the daemon's own bundle
	# route expects.
	header /pkg/* Cache-Control "no-cache"

	# The wasm bundle is a large download; keep the transfer compressed end to
	# end and let Caddy do the work on the wire.
	encode zstd gzip

	# A week of HSTS is enough to be taken seriously and short enough to undo if
	# the certificate is ever mis-issued. No `preload`: that is a one-way door.
	header Strict-Transport-Security "max-age=604800"

	# Access log — the only place a failed login, a 5xx or a slow turn can be
	# read from. Kept in the container; see README.md for how to read it.
	log {
		output stdout
		format console
	}
}
